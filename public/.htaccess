# Para hosting Apache / cPanel. (Si usas nginx, ver deploy/nginx.conf)
# El hosting actual pone nginx (HTTPS) delante de Apache: no permite "Options" (da error 500)
# y Apache no ve %{HTTPS}, por eso se usa la cabecera X-Forwarded-Proto.
DirectoryIndex index.html
# Sin esto, /hogar redirige a http://.../hogar/ antes de aplicar las reglas de abajo
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://comunicalo.mx%{REQUEST_URI} [L,R=301]

# URLs del sitio anterior
RewriteCond %{QUERY_STRING} accion=Internet-Eventos
RewriteRule ^index\.php$ /eventos? [L,R=301]
RewriteCond %{QUERY_STRING} accion=(Internet-Empresarial|Telefonia-IP|Servicios-LAN-to-LAN|Servicios-VPN|Redes-y-Wifi|Servidores-Data-Center|Productos-y-Servicios)
RewriteRule ^index\.php$ /empresas? [L,R=301]
RewriteCond %{QUERY_STRING} accion=(Contacto|Atencion-clientes|Escalacion|EscalacionR)
RewriteRule ^index\.php$ /contacto? [L,R=301]
RewriteCond %{QUERY_STRING} accion=.+
RewriteRule ^index\.php$ /transparencia? [L,R=301]
RewriteRule ^index\.php$ / [L,R=301]
RewriteRule ^MCR/ /cobertura [L,R=301]
RewriteRule ^(OTE|TB)/?$ /transparencia [L,R=301]

# /hogar -> /hogar/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*?)/?$ /$1/index.html [L]

# Tipos que Apache podría no conocer (si no, se sirven sin tipo y no se comprimen/cachean)
AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/javascript .js .mjs

# Compresión gzip de texto (HTML, CSS, JS, JSON, SVG, XML). Imágenes, fuentes woff2, PDF y MP3 ya vienen comprimidos.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/ld+json image/svg+xml image/x-icon
</IfModule>

# Caché en el navegador
# - /assets: nombres con hash (cambian en cada build) → 1 año, inmutables
# - imágenes y fuentes de /img: 30 días (si se reemplaza una con el mismo nombre, tarda hasta 30 días en verse; mejor cambiarle el nombre)
# - HTML: siempre se revalida, para que los cambios del sitio se vean de inmediato
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
  ExpiresByType application/pdf "access plus 30 days"
  ExpiresByType audio/mpeg "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Las respuestas comprimidas varían según lo que acepte el navegador
  Header append Vary Accept-Encoding
</IfModule>
